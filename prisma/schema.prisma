datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  avatarUrl     String?
  passwordHash  String?
  provider      String    @default("local") // "local", "google"
  googleId      String?
  role          String    @default("membro") // "admin", "gestor", "membro"
  department    String?   // Departamento padrão/primário (ex: "RH/DP", "Operações", "TI")
  jobTitle      String?   // Cargo/Função
  status        String    @default("pendente") // "pendente", "ativo", "inativo"
  lastLoginAt   DateTime?

  // Relacionamentos com tarefas
  tasksCreated  Task[]    @relation("TaskCreator")
  tasksAssigned Task[]    @relation("TaskAssignee")

  // Relacionamentos muitos-para-muitos (Gestor e Membro)
  managedDepartments ManagerDepartment[]
  managedTeams       ManagerTeam[]
  memberDepartments  MemberDepartment[]
  memberTeams        MemberTeam[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([department])
}

model Department {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  color       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  teams       Team[]
  categories  Category[]
  tasks       Task[]

  managers    ManagerDepartment[]
  members     MemberDepartment[]
}

model Team {
  id           String     @id @default(cuid())
  name         String
  description  String?
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  managers     ManagerTeam[]
  members      MemberTeam[]

  @@unique([name, departmentId])
  @@index([departmentId])
}

// Tabelas de Junção / Associação (Muitos-para-Muitos)

model ManagerDepartment {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, departmentId])
  @@index([userId])
  @@index([departmentId])
}

model ManagerTeam {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, teamId])
  @@index([userId])
  @@index([teamId])
}

model MemberDepartment {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, departmentId])
  @@index([userId])
  @@index([departmentId])
}

model MemberTeam {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, teamId])
  @@index([userId])
  @@index([teamId])
}

model Category {
  id             String      @id @default(cuid())
  name           String
  departmentName String
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  tasks          Task[]

  @@unique([name, departmentName])
  @@index([departmentName])
}

model Task {
  id              String      @id
  title           String
  why             String
  where           String
  startDate       String
  deadlineDate    String
  who             String      // Nome do responsável para exibição rápida
  how             String
  howMuch         Float       @default(0)
  department      String
  category        String
  competence      String
  priority        String
  status          String
  progressPercent Float       @default(0)
  completionDate  String?
  observations    String?
  
  departmentRel   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  departmentId    String?
  categoryRel     Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId      String?

  createdById     String?
  createdBy       User?       @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignedUserId  String?
  assignedUser    User?       @relation("TaskAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([department])
  @@index([category])
  @@index([status])
  @@index([deadlineDate])
  @@index([competence])
  @@index([who])
  @@index([priority])
  @@index([createdById])
  @@index([assignedUserId])
}

model WorkspaceConfig {
  id                     String   @id @default("default")
  workspaceName          String   @default("5W2H Gerenciamento de Rotinas")
  departmentName         String   @default("RH/DP")
  currencySymbol         String   @default("R$")
  attentionThresholdDays Int      @default(3)
  departments            Json?
  categoriesByDepartment Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}
